{
  "type": "comment",
  "family": "page",
  "remote": { "see": "read", "send": "full" },
  "private": true,
  "schema": "comment@2",
  "reads": ["comment@1", "comment@2"],
  "anchors": ["element", "range", "source", "point"],
  "glyph": { "detach": true, "leader": "dotted" },
  "label": "Comment",
  "icons": { "light": "icon-light.svg", "dark": "icon-dark.svg" },
  "settings": {
    "small": {
      "type": "object",
      "properties": {
        "shared": { "type": "boolean", "title": "Visible to Claude", "default": true },
        "leader": { "type": "string", "title": "Leader line", "enum": ["dotted", "faint", "hover"], "default": "dotted" }
      }
    }
  },
  "hotkeys": [{ "action": "arm", "label": "Pin comment", "default": "C" }],
  "profiles": false,
  "input": "taps",
  "wake": { "coalesce": "count", "respond": true },
  "summary_key": "text"
}
